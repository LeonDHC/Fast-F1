    "                sc_laps.append(CurrentLap)  # Record the lap as under safety car\n",
    "                CurrentLapTime = (\n",
    "                    BasePace[CurrentTire]\n",
    "                    + TireDegradation[CurrentTire] * (1.0 ** laps_on_tire)  # Reduce Tire Deg under SC\n",
    "                    + BasePace[CurrentTire] * 0.5 * SC_Active # no fuel burnt advantage\n",
