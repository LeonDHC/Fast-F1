    "                tire_colors.append(\"white\")\n",
    "\n",
    "            CurrentLap += 1\n",
    "            laps_on_tire += 1  # Increment laps on the current tire\n",
    "\n",
    "        # Switch to the next tire after the pit stop\n",
    "        if stint_index < len(pit_laps):\n",
    "            CurrentTire = strategy[stint_index + 1]  # Switch to the next tire\n",
    "            laps_on_tire = 0  # Reset laps on the new tire\n",
    "\n",
    "    if plot:\n",
    "        # Plot the lap times with a black background\n",
    "        plt.figure(figsize=(10, 6), facecolor=\"black\")\n",
    "        ax = plt.gca()\n",
    "        ax.set_facecolor(\"black\")\n",
    "\n",
    "        # Highlight SC active phases with red bars (only if SC laps exist)\n",
    "        if sc_laps:  # Check if there are any SC-active laps\n",
    "            start_sc = sc_laps[0]\n",
    "            for i in range(1, len(sc_laps)):\n",
    "                if sc_laps[i] != sc_laps[i - 1] + 1:  # Check if the SC phase ends\n",
    "                    plt.axvspan(start_sc, sc_laps[i - 1] + 1, color=\"red\", alpha=0.3, label=\"SC Phase\")\n",
    "                    start_sc = sc_laps[i]\n",
    "            # Add the last SC phase\n",
    "            plt.axvspan(start_sc, sc_laps[-1] + 1, color=\"red\", alpha=0.3, label=\"SC Phase\")\n",
    "\n",
    "        # Plot lap times\n",
    "        for i in range(len(lap_numbers) - 1):\n",
    "            plt.plot(\n",
    "                lap_numbers[i:i+2],  # Plot each lap as a segment\n",
