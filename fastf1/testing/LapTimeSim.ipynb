    "import matplotlib.pyplot as plt\n",
    "from itertools import permutations\n",
    "\n",
    "Number_of_Laps = 50\n",
    "Track_Length = 4.5  # km\n",
    "Track_Temp = 25  # C\n",
    "Track_Condition = 1.0  # 1.0 = dry, 0.8 = wet, 0.5 = very wet\n",
    "\n",
    "BasePace = {\"Soft\": 94.5, \"Medium\": 95.5, \"Hard\": 96.5}  # Base pace for each tire compound\n",
    "TireDegradation = {\"Soft\": 1.5, \"Medium\": 1.0, \"Hard\": 0.5}  # Base degradation per lap for each tire\n",
    "Tires = [\"Soft\", \"Medium\", \"Hard\"]\n",
    "\n",
    "Sensetivity_Weight = 1.5  # s/kg\n",
    "Fuel_Start = 45  # kg\n",
    "Fuel_Burn = 0.5  # kg/lap\n",
    "\n",
    "StopTime_Delta = 22  # s\n",
    "\n",
    "# Function to simulate a race with a given tire strategy and pit stop laps\n",
    "def simulate_race(strategy, pit_laps, plot=False):\n",
    "    CumulativeLapTime = 0.0\n",
    "    Fuel_Remaining = Fuel_Start\n",
    "    CurrentLap = 1\n",
    "    CurrentTire = strategy[0]  # Start with the first tire in the strategy\n",
    "    lap_times = []  # Store lap times for plotting\n",
    "    lap_numbers = []  # Store lap numbers for plotting\n",
    "    tire_colors = []  # Store tire colors for plotting\n",
    "    laps_on_tire = 0  # Track laps completed on the current tire\n",
    "\n",
    "    for stint_index, stint_length in enumerate(pit_laps + [Number_of_Laps - sum(pit_laps)]):\n",
    "        for lap in range(stint_length):\n",
    "            if CurrentLap > Number_of_Laps:\n",
    "                break  # Stop if we've completed all laps\n",
    "\n",
    "            Fuel_Burnt = Fuel_Start - Fuel_Remaining\n",
    "            # Apply exponential tire degradation\n",
    "            CurrentLapTime = (\n",
    "                BasePace[CurrentTire]\n",
    "                + TireDegradation[CurrentTire] * (1.15 ** laps_on_tire)  # Exponential degradation\n",
    "                - (Sensetivity_Weight * Fuel_Burnt)\n",
    "            )\n",
    "            # Add pit stop time to the lap where the tire changes\n",
    "            if lap == stint_length - 1 and stint_index < len(pit_laps):\n",
    "                CurrentLapTime += StopTime_Delta\n",
    "\n",
    "            CumulativeLapTime += CurrentLapTime\n",
    "            Fuel_Remaining -= Fuel_Burn\n",
    "\n",
    "            # Store data for plotting\n",
    "            lap_times.append(CurrentLapTime)\n",
    "            lap_numbers.append(CurrentLap)\n",
    "            if CurrentTire == \"Soft\":\n",
    "                tire_colors.append(\"red\")\n",
    "            elif CurrentTire == \"Medium\":\n",
    "                tire_colors.append(\"yellow\")\n",
    "            elif CurrentTire == \"Hard\":\n",
    "                tire_colors.append(\"white\")\n",
    "\n",
    "            CurrentLap += 1\n",
    "            laps_on_tire += 1  # Increment laps on the current tire\n",
    "\n",
    "        # Switch to the next tire after the pit stop\n",
    "        if stint_index < len(pit_laps):\n",
    "            CurrentTire = strategy[stint_index + 1]  # Switch to the next tire\n",
    "            laps_on_tire = 0  # Reset laps on the new tire\n",
    "\n",
    "    if plot:\n",
    "        # Plot the lap times with a black background\n",
    "        plt.figure(figsize=(10, 6), facecolor=\"black\")\n",
    "        ax = plt.gca()\n",
    "        ax.set_facecolor(\"black\")\n",
    "        for i in range(len(lap_numbers) - 1):\n",
    "            plt.plot(\n",
    "                lap_numbers[i:i+2],  # Plot each lap as a segment\n",
    "                lap_times[i:i+2],\n",
    "                color=tire_colors[i],\n",
    "                linewidth=2,\n",
    "            )\n",
    "        plt.xlabel(\"Lap Number\", color=\"white\")\n",
    "        plt.ylabel(\"Lap Time (s)\", color=\"white\")\n",
    "        plt.title(\"Lap Time Over Number of Laps (Fastest Strategy)\", color=\"white\")\n",
    "        plt.grid(color=\"gray\", linestyle=\"--\", linewidth=0.5)\n",
    "        ax.tick_params(colors=\"white\")  # Set tick colors to white\n",
    "        plt.show()\n",
    "\n",
    "    return CumulativeLapTime\n",
    "\n",
    "# Generate all possible strategies (combinations of tires and pit stop laps)\n",
    "strategies = []\n",
    "for num_tires in range(2, 4):  # Allow up to 4 tire sets\n",
    "    for perm in permutations(Tires, num_tires):  # Generate permutations of `num_tires` length\n",
    "        for pit_laps in product(range(1, Number_of_Laps), repeat=num_tires - 1):  # Generate pit stop combinations\n",
    "            if sum(pit_laps) < Number_of_Laps:  # Ensure total pit laps don't exceed total laps\n",
    "                strategies.append((perm, list(pit_laps)))\n",
    "\n",
    "# Simulate all strategies and find the fastest one\n",
    "best_time = float(\"inf\")\n",
    "best_strategy = None\n",
    "\n",
    "for strategy, pit_laps in strategies:\n",
    "    total_time = simulate_race(strategy, pit_laps)\n",
    "    if total_time < best_time:\n",
    "        best_time = total_time\n",
    "        best_strategy = (strategy, pit_laps)\n",
    "\n",
    "# Output the best strategy and its total time\n",
    "print(f\"Best Strategy: {best_strategy[0]} with pit stops at laps {best_strategy[1]}\")\n",
    "print(f\"Total Time: {best_time:.2f} seconds\")\n",
    "\n",
    "# Plot the fastest strategy\n",
    "simulate_race(best_strategy[0], best_strategy[1], plot=True)"
   ]
