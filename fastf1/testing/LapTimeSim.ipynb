    "        # Add legend only if SC phases exist\n",
    "        if sc_laps:\n",
    "            plt.legend(loc=\"upper left\", fontsize=\"small\", facecolor=\"black\", edgecolor=\"white\", labelcolor=\"white\")\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "    return CumulativeLapTime, sc_laps\n",
