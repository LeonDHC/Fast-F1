    "# create a random number of laps where SC is active for 5 laps (sc_duration)\n",
    "def generate_sc_schedule(number_of_laps, sc_probability=0.0125, sc_duration=5):\n",
    "    sc_laps = []\n",
    "    for lap in range(1, number_of_laps + 1):\n",
    "        if random.random() < sc_probability and (not sc_laps or lap > sc_laps[-1] + sc_duration):\n",
    "            sc_laps.extend(range(lap, min(lap + sc_duration, number_of_laps + 1)))\n",
    "    return sc_laps\n",
    "\n",
    "# Generate the safety car schedule for given number of laps\n",
    "shared_sc_schedule = generate_sc_schedule(Number_of_Laps)\n",
    "print(f\"Safety Car in Laps: {shared_sc_schedule}\")\n",
    "\n",
    "#Hyperparameters\n",
    "BasePace = {\"Soft\": 94.5, \"Medium\": 95.5, \"Hard\": 97.5}  # Base pace for each tire compound\n",
