    "from matplotlib import pyplot as plt\n",
    "import numpy as np\n",
    "import fastf1\n",
    "import fastf1.plotting\n",
    "\n",
    "fastf1.plotting.setup_mpl(misc_mpl_mods=False, color_scheme='fastf1')\n",
    "\n",
    "session = fastf1.get_session(2025, 'China', 'Q')\n",
    "\n",
    "session.load()\n",
    "fast_leclerc = session.laps.pick_drivers('VER').pick_fastest()\n",
    "lec_car_data = fast_leclerc.get_car_data()\n",
    "t = lec_car_data['Time']\n",
    "vCar = lec_car_data['Speed']\n",
    "\n",
    "fast_ver = session.laps.pick_drivers('LAW').pick_fastest()\n",
    "ver_car_data = fast_ver.get_car_data()\n",
    "v = ver_car_data['Time']\n",
    "vCarVer = ver_car_data['Speed']\n",
    "\n",
    "# Convert time to numeric values (seconds since the start of the session)\n",
    "t_seconds = (t - t.iloc[0]).dt.total_seconds()\n",
    "v_seconds = (v - v.iloc[0]).dt.total_seconds()\n",
    "\n",
    "# Interpolate LAW's speed to match VER's time points for consistent comparison\n",
    "vCarVer_interp = np.interp(t_seconds, v_seconds, vCarVer)\n",
    "speed_gap = vCar - vCarVer_interp\n",
    "\n",
    "# Calculate the cumulative time gap\n",
    "# Avoid division by zero by adding a small epsilon to the denominator\n",
    "average_speed = (vCar + vCarVer_interp) / 2\n",
    "time_gap = np.cumsum(speed_gap / (average_speed + 1e-6) * np.gradient(t_seconds))\n",
    "\n",
    "# The rest is just plotting\n",
    "fig, ax = plt.subplots()\n",
    "ax.plot(t_seconds, vCar, label='VER')\n",
    "ax.plot(v_seconds, vCarVer, label='LAW')\n",
    "ax.plot(t_seconds, time_gap, label='Cumulative Time Gap (VER - LAW)', linestyle='--')\n",
    "ax.set_xlabel('Time [s]')\n",
    "ax.set_ylabel('Time Gap [s]')\n",
    "ax.set_title('vCar and Cumulative Time Gap')\n",
    "ax.legend()\n",
    "plt.show()"
   ]
