    "    \n",
    "    # Store the final position of the driver\n",
    "    final_position = drv_laps['Position'].iloc[-1]\n",
    "    driver_styles[abb] = (final_position, style)\n",
    "\n",
    "# Sort drivers by their final position\n",
    "sorted_drivers = sorted(driver_styles.items(), key=lambda x: x[1][0])\n",
    "\n",
    "# Add the legend in the sorted order\n",
