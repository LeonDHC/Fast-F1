    "# Convert lap times to seconds\n",
    "combined_laps['LapTimeSeconds'] = combined_laps['LapTime'].dt.total_seconds()\n",
    "\n",
    "# Calculate the mean lap time of VER\n",
    "ver_mean_lap_time_seconds = ver_laps['LapTime'].dt.total_seconds().mean()\n",
    "\n",
    "# Calculate the difference between the mean lap time of VER and the current lap time\n",
    "combined_laps['DifferenceFromVERMean'] = combined_laps['LapTimeSeconds'] - ver_mean_lap_time_seconds\n",
    "\n",
    "# Calculate the cumulative sum of the differences for each driver\n",
    "combined_laps['CumulativeDifference'] = combined_laps.groupby('Driver')['DifferenceFromVERMean'].cumsum()\n",
    "\n",
    "print(combined_laps[['LapNumber', 'Driver', 'LapTime', 'LapTimeSeconds', 'DifferenceFromVERMean', 'CumulativeDifference']])\n",
    "\n",
    "# Define a custom color palette for drivers\n",
    "driver_palette = {\n",
    "    \"VER\": \"blue\",  # Blue line for VER\n",
    "    \"LAW\": \"white\"  # White line for LAW\n",
    "}\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 8), facecolor=\"black\")  # Set background to black for better contrast\n",
    "\n",
    "# Plot the cumulative difference for both drivers\n",
    "sns.lineplot(data=combined_laps,\n",
    "             x=\"LapNumber\",\n",
    "             y=\"CumulativeDifference\",\n",
    "             ax=ax,\n",
    "             hue=\"Driver\",  # Use Driver to differentiate between VER and LAW\n",
