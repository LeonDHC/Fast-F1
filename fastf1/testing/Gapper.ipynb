    "from matplotlib.ticker import MultipleLocator\n",
    "\n",
    "# Get laps for VER and LAW\n",
    "ver_laps = race.laps.pick_drivers(\"VER\")\n",
    "law_laps = race.laps.pick_drivers(\"LAW\")\n",
    "\n",
    "# Combine the laps for both drivers into a single DataFrame\n",
    "combined_laps = pd.concat([ver_laps, law_laps])\n",
    "combined_laps['Driver'] = combined_laps['Driver'].astype(str)  # Ensure Driver column is string type\n",
    "\n",
    "# Convert lap times to seconds\n",
    "combined_laps['LapTimeSeconds'] = combined_laps['LapTime'].dt.total_seconds()\n",
    "\n",
    "# Normalize lap times against the mean lap time of VER\n",
    "ver_mean_lap_time_seconds = ver_laps['LapTime'].dt.total_seconds().mean()\n",
    "combined_laps['NormalizedLapTime'] = combined_laps['LapTimeSeconds'] - ver_mean_lap_time_seconds\n",
    "\n",
    "print(combined_laps[['LapNumber', 'Driver', 'LapTime', 'LapTimeSeconds', 'NormalizedLapTime']])\n",
    "\n",
    "# Define a custom color palette for drivers\n",
    "driver_palette = {\n",
    "    \"VER\": \"blue\",  # Blue line for VER\n",
    "    \"LAW\": \"white\"  # White line for LAW\n",
    "}\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 8), facecolor=\"black\")  # Set background to black for better contrast\n",
    "\n",
    "# Plot the normalized lap times for both drivers\n",
    "sns.lineplot(data=combined_laps,\n",
    "             x=\"LapNumber\",\n",
    "             y=\"NormalizedLapTime\",\n",
    "             ax=ax,\n",
    "             hue=\"Driver\",  # Use Driver to differentiate between VER and LAW\n",
    "             palette=driver_palette,  # Use custom driver colors\n",
    "             linewidth=2)\n",
    "\n",
    "ax.set_xlabel(\"Lap Number\", color=\"white\")\n",
    "ax.set_ylabel(\"Normalized Lap Time (s)\", color=\"white\")\n",
    "\n",
    "# Add a horizontal line at 0 for reference\n",
    "ax.axhline(0, color=\"gray\", linestyle=\"--\", linewidth=1)\n",
    "\n",
    "# Set y-axis ticks every 0.25 seconds (250 milliseconds)\n",
    "# ax.yaxis.set_major_locator(MultipleLocator(0.25))\n",
    "\n",
    "# Customize the plot appearance for better visibility\n",
    "ax.tick_params(colors=\"white\")  # Set tick colors to white\n",
    "ax.spines[\"top\"].set_color(\"white\")\n",
    "ax.spines[\"right\"].set_color(\"white\")\n",
    "ax.spines[\"left\"].set_color(\"white\")\n",
    "ax.spines[\"bottom\"].set_color(\"white\")\n",
    "\n",
    "# Turn on major grid lines\n",
    "plt.grid(color=\"gray\", which=\"major\", axis=\"both\")\n",
    "sns.despine(left=True, bottom=True)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
